<Window x:Class="BandwidthTester.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="대역폭 테스트 시뮬레이터" Width="1300" Height="750"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="btnLoad" Content="설정 불러오기" Width="110" Margin="0,0,6,0" Click="BtnLoad_Click"/>
            <Button x:Name="btnSave" Content="설정 저장" Width="90" Margin="0,0,20,0" Click="BtnSave_Click"/>
            <Button x:Name="btnAdd" Content="소켓 추가" Width="90" Margin="0,0,6,0" Click="BtnAdd_Click"/>
            <Button x:Name="btnEdit" Content="선택 편집" Width="90" Margin="0,0,6,0" Click="BtnEdit_Click"/>
            <Button x:Name="btnDelete" Content="선택 삭제" Width="90" Margin="0,0,20,0" Click="BtnDelete_Click"/>
            <Button x:Name="btnStartAll" Content="전체 시작" Width="90" Margin="0,0,6,0" Click="BtnStartAll_Click"/>
            <Button x:Name="btnStopAll" Content="전체 정지" Width="90" Click="BtnStopAll_Click"/>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Height="160" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="로그" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtLog" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="NoWrap"/>
        </Grid>

        <DataGrid x:Name="gridSockets" AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionMode="Extended" IsReadOnly="True" RowHeight="28">
            <DataGrid.Columns>
                <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="130"/>
                <DataGridTextColumn Header="역할/프로토콜" Binding="{Binding RoleProtocol}" Width="110"/>
                <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="150"/>
                <DataGridTextColumn Header="Remote" Binding="{Binding Remote}" Width="150"/>
                <DataGridTextColumn Header="메시지 크기" Binding="{Binding MessageSize}" Width="80"/>
                <DataGridTextColumn Header="목표 대역폭" Binding="{Binding Bandwidth}" Width="90"/>
                <DataGridTextColumn Header="엔디안" Binding="{Binding Endianness}" Width="120"/>
                <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="TX 속도" Binding="{Binding TxRateText}" Width="90"/>
                <DataGridTextColumn Header="RX 속도" Binding="{Binding RxRateText}" Width="90"/>
                <DataGridTextColumn Header="TX 총량" Binding="{Binding TxTotal}" Width="90"/>
                <DataGridTextColumn Header="RX 총량" Binding="{Binding RxTotal}" Width="90"/>
                <DataGridTextColumn Header="상대측" Binding="{Binding RemoteEndpoint}" Width="140"/>
                <DataGridTextColumn Header="오류" Binding="{Binding LastError}" Width="160"/>
                <DataGridTemplateColumn Header="동작" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="시작" Width="55" Margin="2" Click="BtnRowStart_Click"/>
                                <Button Content="정지" Width="55" Margin="2" Click="BtnRowStop_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
