<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BandwidthTester.AvaloniaGui.SimpleMessageWindow"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="알림">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock Name="MessageText" TextWrapping="Wrap"/>
        <Button Name="OkButton" Content="확인" HorizontalAlignment="Right" Width="80" Click="OkButton_Click"/>
    </StackPanel>
</Window>
