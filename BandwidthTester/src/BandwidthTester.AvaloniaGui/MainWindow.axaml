<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        x:Class="BandwidthTester.AvaloniaGui.MainWindow"
        Title="대역폭 테스트 시뮬레이터" Width="1440" Height="700"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
            <Button Name="btnLoad" Content="설정 불러오기" Width="110" Click="BtnLoad_Click"/>
            <Button Name="btnSave" Content="다른 이름으로 저장" Width="150" Margin="0,0,14,0" Click="BtnSave_Click"/>
            <Button Name="btnAdd" Content="소켓 추가" Width="90" Click="BtnAdd_Click"/>
            <Button Name="btnCopy" Content="선택 복사" Width="90" Click="BtnCopy_Click"/>
            <Button Name="btnEdit" Content="선택 편집" Width="90" Click="BtnEdit_Click"/>
            <Button Name="btnDelete" Content="선택 삭제" Width="90" Margin="0,0,14,0" Click="BtnDelete_Click"/>
            <Button Name="btnStartAll" Content="전체 시작" Width="90" Click="BtnStartAll_Click"/>
            <Button Name="btnStopAll" Content="전체 정지" Width="90" Click="BtnStopAll_Click"/>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Height="150" Margin="0,8,0,0" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="로그 (설정 변경은 자동으로 config.json에 저장됩니다)" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox Name="txtLog" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                     FontFamily="Consolas,monospace" TextWrapping="NoWrap"
                     VerticalContentAlignment="Top"/>
        </Grid>

        <controls:DataGrid Name="gridSockets" AutoGenerateColumns="False" CanUserResizeColumns="True"
                            SelectionMode="Extended" IsReadOnly="True" RowHeight="28">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="100"/>
                <controls:DataGridTextColumn Header="역할/프로토콜" Binding="{Binding RoleProtocol}" Width="105"/>
                <controls:DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="125"/>
                <controls:DataGridTextColumn Header="Remote" Binding="{Binding Remote}" Width="125"/>
                <controls:DataGridTextColumn Header="메시지" Binding="{Binding MessageSize}" Width="65"/>
                <controls:DataGridTextColumn Header="대역폭" Binding="{Binding Bandwidth}" Width="80"/>
                <controls:DataGridTextColumn Header="엔디안" Binding="{Binding Endianness}" Width="90"/>
                <controls:DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="70"/>
                <controls:DataGridTextColumn Header="속도 (TX / RX)" Binding="{Binding RateText}" Width="150"/>
                <controls:DataGridTextColumn Header="누적 (TX / RX)" Binding="{Binding TotalText}" Width="150"/>
                <controls:DataGridTextColumn Header="상대측" Binding="{Binding RemoteEndpoint}" Width="120"/>
                <controls:DataGridTextColumn Header="오류" Binding="{Binding LastError}" Width="110"/>
                <controls:DataGridTemplateColumn Header="동작" Width="115">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Content="시작" Width="55" IsEnabled="{Binding IsNotRunning}" Click="BtnRowStart_Click"/>
                                <Button Content="정지" Width="55" IsEnabled="{Binding IsRunning}" Click="BtnRowStop_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
            </controls:DataGrid.Columns>
        </controls:DataGrid>
    </DockPanel>
</Window>
